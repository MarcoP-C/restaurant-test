# PostgreSQL Connection (Neon)
# Reemplaza con tu connection string de Neon: https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Contraseña del administrador (mínimo 8 caracteres, NO uses "changeme123")
ADMIN_PASSWORD=

# Secret para firmar las cookies de sesión (mínimo 16 caracteres random)
SESSION_SECRET=

# Opcional: Zona horaria del negocio
# APP_TIMEZONE=America/Mexico_City

# Opcional: URL de Vercel Storage para imágenes
# BUCKET_URL=https://storage-api-url.vercel.app